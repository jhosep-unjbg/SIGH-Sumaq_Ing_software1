# SUMAQ Hotel - Variables de entorno (MVP)

# App
APP_NAME=SUMAQ Hotel API
ENVIRONMENT=development
DEBUG=true

# CORS (separar por comas)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# PostgreSQL Primary
DATABASE_URL=postgresql+asyncpg://sumaq:sumaq@localhost:5432/sumaq_hotel

# PostgreSQL Replica (solo lectura)
DATABASE_READ_URL=postgresql+asyncpg://sumaq:sumaq@localhost:5433/sumaq_hotel

# JWT (Auth Server segregado)
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Multi-tenant
TENANT_HEADER=X-Tenant-ID

# Plantilla de configuración local. Copiar como .env y reemplazar CHANGE_ME.
# No usar estos valores de ejemplo en producción.

# App
APP_NAME=SUMAQ Hotel API
ENVIRONMENT=development
DEBUG=true

# CORS (lista JSON para Pydantic Settings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# PostgreSQL (el usuario y la contraseña deben coincidir en ambas variables)
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sumaq_hotel
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@db:5432/sumaq_hotel

# Opcional: configurar solo cuando exista una réplica.
# DATABASE_READ_URL=postgresql+asyncpg://usuario:contraseña@db-replica:5432/sumaq_hotel

# JWT (Auth Server segregado)
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Multi-tenant
TENANT_HEADER=X-Tenant-ID
